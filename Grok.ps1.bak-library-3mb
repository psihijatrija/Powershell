# --- Harden-RemoteAccess.ps1 ---
function Harden-RemoteAccess {
    try {
        Write-Log "Starting Windows Remote Access Security Hardening..."
        # Disable Remote Desktop (RDP)
        Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\Terminal Server" -Name "fDenyTSConnections" -Value 1 -ErrorAction Stop
        Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp" -Name "UserAuthentication" -Value 1 -ErrorAction Stop
        Set-ItemProperty -Path "HKLM:\SYSTEM\CurrentControlSet\Control\Remote Assistance" -Name "fAllowToGetHelp" -Value 0 -ErrorAction Stop
        Write-Log "Remote Desktop and Remote Assistance disabled."

        # Block common remote access ports
        New-NetFirewallRule -DisplayName "Block RDP Inbound" -Direction Inbound -Protocol TCP -LocalPort 3389 -Action Block -Enabled True -ErrorAction Stop
        New-NetFirewallRule -DisplayName "Block VNC Inbound" -Direction Inbound -Protocol TCP -LocalPort 5900-5902 -Action Block -Enabled True -ErrorAction Stop
        New-NetFirewallRule -DisplayName "Block TeamViewer Inbound" -Direction Inbound -Protocol TCP -LocalPort 5938 -Action Block -Enabled True -ErrorAction Stop
        New-NetFirewallRule -DisplayName "Block AnyDesk Inbound" -Direction Inbound -Protocol TCP -LocalPort 7070 -Action Block -Enabled True -ErrorAction Stop
        Write-Log "Firewall rules added to block RDP, VNC, TeamViewer, and AnyDesk ports."

        # Disable Remote Desktop Services via Group Policy
        $gpPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows NT\Terminal Services"
        if (-not (Test-Path $gpPath)) {
            New-Item -Path $gpPath -Force | Out-Null
        }
        Set-ItemProperty -Path $gpPath -Name "fDenyTSConnections" -Value 1 -ErrorAction Stop
        Write-Log "Group Policy updated to disable Remote Desktop Services."

        # Disable default Administrator account
        $adminAccount = Get-LocalUser -Name "Administrator" -ErrorAction SilentlyContinue
        if ($adminAccount) {
            Disable-LocalUser -Name "Administrator" -ErrorAction Stop
            Write-Log "Default Administrator account disabled."
        } else {
            Write-Log "Default Administrator account not found or already disabled."
        }

        # Restrict unauthorized software installation
        $restrictPath = "HKLM:\SOFTWARE\Policies\Microsoft\Windows\System"
        if (-not (Test-Path $restrictPath)) {
            New-Item -Path $restrictPath -Force | Out-Null
        }
        $blockedApps = "TeamViewer.exe,AnyDesk.exe"
        Set-ItemProperty -Path $restrictPath -Name "DisallowRun" -Value 1 -ErrorAction Stop
        New-Item -Path "$restrictPath\DisallowRun" -Force | Out-Null
        $blockedApps.Split(",") | ForEach-Object { Set-ItemProperty -Path "$restrictPath\DisallowRun" -Name $_ -Value $_ -ErrorAction Stop }
        Write-Log "Group Policy updated to block specified remote access software."

        # Disable UPnP
        Set-Service -Name "SSDPSRV" -StartupType Disabled -ErrorAction Stop
        Stop-Service -Name "SSDPSRV" -Force -ErrorAction SilentlyContinue
        Write-Log "UPnP service disabled."

        # Enable Windows Defender real-time protection
        Set-MpPreference -DisableRealtimeMonitoring $false -ErrorAction Stop
        Write-Log "Windows Defender real-time protection enabled."

        # Verify RDP port
        $rdpPort = netstat -an | Select-String "3389"
        if ($rdpPort) {
            Write-Log "Port 3389 is still listening. Check firewall and service settings manually." "Warning"
        } else {
            Write-Log "RDP port 3389 is not listening."
        }

        Write-Log "Remote access hardening complete. Recommended manual steps: Check Event Viewer, ensure Windows updates, consider VPN, verify firewall rules."
    } catch {
        Write-Log "Error during remote access hardening: $($_.Exception.Message)" "Error"
    }
}

