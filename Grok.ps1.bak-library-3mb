# --- Enable-DoH.ps1 ---
function Enable-DoH {
    Write-Log "Configuring DNS over HTTPS settings..."
    try {
        # Set DoH Policy for DNS Client
        $dnsCacheParams = "HKLM:\SYSTEM\CurrentControlSet\Services\Dnscache\Parameters"
        Set-ItemProperty -Path $dnsCacheParams -Name "DoHPolicy" -Value 1 -Type DWord -Force -ErrorAction Stop
        Write-Log "Set DoHPolicy to enabled."

        # Configure Microsoft Edge DoH settings
        $edgePolicy = "HKLM:\SOFTWARE\Policies\Microsoft\Edge"
        if (-not (Test-Path $edgePolicy)) {
            New-Item -Path $edgePolicy -Force | Out-Null
        }
        Set-ItemProperty -Path $edgePolicy -Name "DnsOverHttpsMode" -Value "on" -Force -ErrorAction Stop
        Set-ItemProperty -Path $edgePolicy -Name "EncryptedClientHelloEnabled" -Value 1 -Type DWord -Force -ErrorAction Stop
        Write-Log "Configured Microsoft Edge for DoH and Encrypted Client Hello."

        # Set TCP/IP DoH settings
        $tcpipParams = "HKLM:\SYSTEM\CurrentControlSet\Services\Tcpip\Parameters"
        Set-ItemProperty -Path $tcpipParams -Name "EnableDoH" -Value 1 -Type DWord -Force -ErrorAction Stop
        Write-Log "Set EnableDoH for Tcpip parameters."

        # Enable Auto DoH for Windows DNS
        $dnsParams = "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\DNS"
        if (-not (Test-Path $dnsParams)) {
            New-Item -Path $dnsParams -Force | Out-Null
        }
        Set-ItemProperty -Path $dnsParams -Name "EnableAutoDoh" -Value 1 -Type DWord -Force -ErrorAction Stop
        Write-Log "Enabled AutoDoH for Windows DNS."
    } catch {
        Write-Log "Error configuring DoH settings: $_"
    }
}

