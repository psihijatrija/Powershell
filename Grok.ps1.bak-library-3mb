# --- Run-Benchmark.ps1 ---
function Run-Benchmark {
    try {
        # Run Benchmarks
        $cpuScore = Test-CPU
        $memoryWriteScore, $memoryReadScore = Test-Memory
        $diskScore = Test-Disk
        $graphicsScore = Test-Graphics

        # Minimize PowerShell console window
        [Console]::WindowWidth = 0
        [Console]::WindowHeight = 0

        # Create Form
        $form = New-Object System.Windows.Forms.Form
        $form.Text = "Benchmark Results"
        $form.Size = New-Object System.Drawing.Size(640, 480)
        $form.StartPosition = "CenterScreen"

        # Create Label for Results
        $label = New-Object System.Windows.Forms.Label
        $label.Location = New-Object System.Drawing.Point(10, 10)
        $label.Size = New-Object System.Drawing.Size(600, 400)
        $label.Text = @"
CPU Score: $cpuScore
Memory Write Score: $memoryWriteScore
Memory Read Score: $memoryReadScore
Disk Score: $diskScore
Graphics Score: $graphicsScore
"@
        $form.Controls.Add($label)

        # Create Screenshot Button
        $button = New-Object System.Windows.Forms.Button
        $button.Location = New-Object System.Drawing.Point(540, 10)
        $button.Size = New-Object System.Drawing.Size(90, 30)
        $button.Text = "Screenshot"
        $button.Add_Click({
            try {
                # Capture Form as Bitmap
                $bitmap = New-Object System.Drawing.Bitmap($form.Width, $form.Height)
                $form.DrawToBitmap($bitmap, $form.ClientRectangle)

                # Copy to Clipboard
                [System.Windows.Forms.Clipboard]::SetImage($bitmap)

                # Save to Pictures Folder
                $picturesFolder = [Environment]::GetFolderPath("MyPictures")
                $timestamp = Get-Date -Format "yyyyMMdd_HHmmss"
                $filePath = Join-Path $picturesFolder "Benchmark_$timestamp.png"
                $bitmap.Save($filePath, [System.Drawing.Imaging.ImageFormat]::Png)

                # Dispose Bitmap
                $bitmap.Dispose()
            } catch {
                Write-ErrorLog "Screenshot Error: $_"
                [System.Windows.Forms.MessageBox]::Show("Failed to capture screenshot: $_", "Screenshot Error", "OK", "Error")
            }
        })
        $form.Controls.Add($button)

        # Show Form
        $form.ShowDialog() | Out-Null
    } catch {
        Write-ErrorLog "Run-Benchmark Error: $_"
        [System.Windows.Forms.MessageBox]::Show("Failed to display results window: $_`nCheck error log at $env:USERPROFILE\Documents\Benchmark_ErrorLog.txt", "Error", "OK", "Error")
    }
}

