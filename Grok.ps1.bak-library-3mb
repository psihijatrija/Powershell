# --- Register-AutoStartHKCU.ps1 ---
function Register-AutoStartHKCU {
    param (
        [string]$TaskName = "SimpleAntivirus",
        [string]$Description = "Simple Antivirus background service"
    )

    $scriptSource = $MyInvocation.MyCommand.Path
    if (-not $scriptSource) { $scriptSource = $PSCommandPath }
    if (-not $scriptSource) {
        Write-Host "Error: Could not determine script path." -ForegroundColor Red
        return
    }

    $targetFolder = "$env:ProgramData\SimpleAntivirus"
    $targetScript = Join-Path $targetFolder (Split-Path $scriptSource -Leaf)

    # Create folder if needed (needs admin the first time)
    if (-not (Test-Path $targetFolder)) {
        try {
            New-Item -Path $targetFolder -ItemType Directory -Force | Out-Null
            Write-Host "Created folder: $targetFolder" -ForegroundColor Green
        }
        catch {
            Write-Host "Cannot create folder in ProgramData (admin rights needed?)" -ForegroundColor Yellow
            Write-Host "Falling back to user profile folder..." -ForegroundColor Yellow
            $targetFolder = "$env:LOCALAPPDATA\SimpleAntivirus"
            $targetScript = Join-Path $targetFolder (Split-Path $scriptSource -Leaf)
            New-Item -Path $targetFolder -ItemType Directory -Force -ErrorAction SilentlyContinue | Out-Null
        }
    }

    # Copy ourselves
    try {
        Copy-Item -Path $scriptSource -Destination $targetScript -Force -ErrorAction Stop
        Write-Host "Script copied to: $targetScript" -ForegroundColor Green
    }
    catch {
        Write-Host "Failed to copy script: $_" -ForegroundColor Red
        return
    }

    $runValue = "powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File `"$targetScript`""

    # ── This is the key part ───────────────────────────────
    try {
        # Remove old value first (clean install)
        Remove-ItemProperty -Path "HKCU:\Software\Microsoft\Windows\CurrentVersion\Run" `
                           -Name $TaskName -ErrorAction SilentlyContinue

        # Create new autostart entry
        New-ItemProperty -Path "HKCU:\Software\Microsoft\Windows\CurrentVersion\Run" `
                        -Name $TaskName `
                        -Value $runValue `
                        -PropertyType String `
                        -Force | Out-Null

        Write-Host "Successfully added to HKCU\...\Run" -ForegroundColor Green
        Write-Host "Next logon the script should start automatically without UAC." -ForegroundColor Cyan
    }
    catch {
        Write-Host "Failed to write Run key: $_" -ForegroundColor Red
    }
}

