# --- Remove-CustomControls.ps1 ---
function Remove-CustomControls {
    param ([string]$name, [string]$value)
    if ($name -and $value) {
        try {
            # Remove registry entry
            Remove-Item -Path "$registryPath\$name" -Force -ErrorAction Stop
            Write-Host "Removed Custom Control: $name with value $value"
            # If it's a file path, attempt to delete the file
            if (Test-Path $value) {
                Remove-Item -Path $value -Force -ErrorAction Stop
                Write-Host "Removed file: $value"
            }
        } catch {
            Write-Host "Error removing $name : $_"
        }
    }
}

