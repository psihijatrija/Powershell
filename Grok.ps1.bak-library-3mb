                                    }
                                } else {
                                    # Valid signed file - allow
                                    $scannedFiles[$fileHash.Hash] = $true
                                    "$($fileHash.Hash),true" | Out-File -FilePath $Database -Append -Encoding UTF8
                                }
                            }
                        }
                    }
                } catch {
                    Log "Error scanning $($file.FullName): $_"
                }
            }
        } catch {
            Log "Error scanning drive $root : $_"
        }
    }
    
    Log "Aggressive drive scan complete"
}
