                                                Remove-Item -Path $dllPath -Force -ErrorAction SilentlyContinue
                                            }
                                        }
                                    }
                                } catch {}
                            }
                        } catch {}
                    }
                }
            } catch {}
        }
    } catch {
        try {
            Write-ErrorLog -Message "COM control monitor tick failed" -Severity "High" -ErrorRecord $_
        } catch {}
    }
}

