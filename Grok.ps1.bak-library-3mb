# --- Scan-And-Decide.ps1 ---
function Scan-And-Decide($file) {
    if (-not (Test-Path $file -PathType Leaf)) { return }
    
    # Check whitelist
    if (Is-WhitelistedFile -filePath $file) {
        Log "Whitelisted file skipped: $file"
        return
    }
    
    $ext = [IO.Path]::GetExtension($file).ToLower()
    if ($ext -notin $MonitoredExtensions) { return }
    
    # 1. Check signature first (fastest check)
    $sig = Get-FileSignature $file
    
    # 2. If unsigned DLL/WINMD in risky path → INSTANT KILL
    if (($ext -in @('.dll', '.winmd')) -and (-not $sig.IsValid) -and (Is-InRiskyPath $file)) {
        Handle-UnsignedFile $file "Unsigned in risky location"
        return
    }
    
    # 3. Compute hash for database checks
    $sha256 = Compute-Hash $file
    if (-not $sha256) { return }
    
    # 4. Check all databases in parallel (async for speed)
    $circlResult = $false
    $cymruResult = $false
    $mbResult = $false
    
    # Start async lookups
    $circlJob = Start-Job -ScriptBlock { 
        param($hash, $url) 
        try { 
            $r = Invoke-RestMethod "$url/$hash" -TimeoutSec 3
            return ($r -and ($r | ConvertTo-Json).Length -gt 10) 
        } catch { 
            return $false 
        }
    } -ArgumentList $sha256, $CirclLookupBase
    
    $cymruJob = Start-Job -ScriptBlock { 
        param($hash, $url) 
        try { 
            $r = Invoke-RestMethod "$url/$hash" -TimeoutSec 3
            return ($r.detections -and $r.detections -ge 60) 
        } catch { 
            return $false 
        }
    } -ArgumentList $sha256, $CymruMHR
    
    $mbJob = Start-Job -ScriptBlock { 
        param($hash, $url, $key) 
        $body = @{ query = 'get_info'; sha256_hash = $hash }
        if ($key) { $body.api_key = $key }
        try { 
            $r = Invoke-RestMethod $url -Method Post -Body $body -TimeoutSec 5
            return ($r.query_status -eq 'ok' -or ($r.data -and $r.data.Count -gt 0))
        } catch { 
            return $false 
        }
    } -ArgumentList $sha256, $MalwareBazaarApi, $MalwareBazaarAuthKey
    
    # Get results
    $circlResult = Receive-Job $circlJob -Wait -AutoRemoveJob
    $cymruResult = Receive-Job $cymruJob -Wait -AutoRemoveJob
    $mbResult = Receive-Job $mbJob -Wait -AutoRemoveJob
    
    # 5. Decision logic
    if ($circlResult) {
        Log "ALLOWED (CIRCL trusted): $file"
        return
    }
    
    if ($cymruResult) {
        Do-Quarantine $file "Cymru MHR malware detection (≥60% AVs)"
        return
    }
    
    if ($mbResult) {
        Do-Quarantine $file "MalwareBazaar database match"
        return
    }
    
    # 6. Signature-based final decision
    if ($sig.IsValid) {
        if ($sig.IsMicrosoft) {
            Log "ALLOWED (Microsoft-signed): $file"
        } else {
            Log "ALLOWED (Valid signature): $file"
        }
    } else {
        # Unsigned file not in risky path
        if ($ext -in @('.dll', '.winmd', '.exe', '.sys')) {
            Log "WARNING: Unsigned executable found: $file"
            # Optionally quarantine here for extra security
            # Do-Quarantine $file "Unsigned executable"
        } else {
            Log "ALLOWED (Non-executable): $file"
        }
    }
}

# --- Scan-DllFiles.ps1 ---
function Scan-DllFiles {
    Write-Log "Starting scan of DLL files across all drives."
    $drives = Get-CimInstance -ClassName Win32_LogicalDisk | Where-Object { $_.DriveType -in (2, 3, 4) }
    foreach ($drive in $drives) {
        $root = $drive.DeviceID + "\"
        Write-Log "Scanning DLL files on drive: $root"
        try {
            $files = Get-ChildItem -Path $root -Filter *.dll -Recurse -File -Exclude @("C:\Windows\System32\config") -ErrorAction Stop
            foreach ($file in $files) {
                $filePath = $file.FullName
                if (Test-ExcludedFile -filePath $filePath) {
                    Write-Log "Skipping excluded DLL file: $filePath"
                    continue
                }
                $fileInfo = $file
                try {
                    $fileHash = Calculate-FileHash -filePath $filePath
                    if ($fileHash) {
                        if ($scannedFiles.ContainsKey($fileHash.Hash)) {
                            Write-Log "Skipping already scanned DLL file: $filePath (Hash: $($fileHash.Hash))"
                            if (-not $scannedFiles[$fileHash.Hash]) {
                                if (Set-FileOwnershipAndPermissions -filePath $filePath) {
                                    Stop-ProcessUsingFile -filePath $filePath
                                    Quarantine-File -filePath $filePath
                                }
                            }
                        } else {
                            $isSignatureValid = $fileHash.Status -eq "Valid"
                            $isMalicious = $false
                            if ($isSignatureValid -and $fileInfo.Length -le ($maxFileSizeMB * 1MB)) {
                                $isMalicious = Scan-FileWithVirusTotal -fileHash $fileHash.Hash -filePath $filePath
                                Start-Sleep -Seconds $retryDelaySeconds  # Rate limit
                            } else {
                                Write-Log "Skipping VT scan for DLL file: $filePath (SignatureValid: $isSignatureValid, Size: $($fileInfo.Length))"
                            }
                            $isValid = $isSignatureValid -and -not $isMalicious
                            $scannedFiles[$fileHash.Hash] = $isValid
                            "$($fileHash.Hash),$isValid" | Out-File -FilePath $localDatabase -Append -Encoding UTF8 -ErrorAction Stop
                            Write-Log "Scanned new DLL file: $filePath (Valid: $isValid)"
                            if (-not $isValid) {
                                if (Set-FileOwnershipAndPermissions -filePath $filePath) {
                                    Stop-ProcessUsingFile -filePath $filePath
                                    Quarantine-File -filePath $filePath
                                }
                            }
                        }
                    }
                } catch {
                    Write-Log "Error processing DLL file ${filePath}: $($_.Exception.Message)"
                }
            }
        } catch {
            Write-Log "DLL scan failed for drive ${root}: $($_.Exception.Message)"
        }
    }
}

# --- Scan-Drive.ps1 ---
function Scan-Drive($root) {
    Write-Host "Starting scan on drive: $root"
    Log "Drive scan start: $root"

    try {
        $stack = New-Object System.Collections.Stack
        $stack.Push($root)

        while ($stack.Count -gt 0) {
            $dir = $stack.Pop()
            try {
                $entries = Get-ChildItem -LiteralPath $dir -Force -ErrorAction Stop
                foreach ($e in $entries) {
                    if ($e.PSIsContainer) {
                        $stack.Push($e.FullName)
                    } else {
                        Decide-And-Act $e.FullName
                    }
                }
            } catch {
                Log "Error enumerating $dir : $_"
                continue
            }
        }
    } catch {
        Log "Scan-Drive failed for $root : $_"
    }

    Write-Host "Drive scan complete: $root"
    Log "Drive scan complete: $root"
}

