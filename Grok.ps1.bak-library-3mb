# --- Show-ResultsWindow.ps1 ---
function Show-ResultsWindow {
    param ($text)
    try {
        $form = New-Object System.Windows.Forms.Form
        $form.Text = "Benchmark Results"
        $form.Size = New-Object System.Drawing.Size(640, 480)
        $form.StartPosition = "CenterScreen"
        $form.TopMost = $true

        $panel = New-Object System.Windows.Forms.Panel
        $panel.Dock = "Top"
        $panel.Height = 45
        $form.Controls.Add($panel)

        $button = New-Object System.Windows.Forms.Button
        $button.Text = "? Screenie"
        $button.Size = New-Object System.Drawing.Size(120, 30)
        $button.Location = New-Object System.Drawing.Point(500, 7)
        $button.Anchor = "Top,Right"
        $button.Add_Click({ Take-Screenie $form })
        $panel.Controls.Add($button)

        $box = New-Object System.Windows.Forms.TextBox
        $box.Multiline = $true
        $box.ReadOnly = $true
        $box.Dock = "Fill"
        $box.ScrollBars = "Vertical"
        $box.Font = New-Object System.Drawing.Font("Consolas", 24)
        $box.Text = $text
        $form.Controls.Add($box)

        $form.Add_Shown({
            $box.SelectionLength = 0
            $form.Activate()
        })

        $form.ShowDialog() | Out-Null
    } catch {
        Write-ErrorLog "Results Window Error: $_"
        [System.Windows.Forms.MessageBox]::Show("Failed to display results window: $_`nCheck error log at $env:USERPROFILE\Documents\Benchmark_ErrorLog.txt", "Error", "OK", "Error")
