                                ProcessName = $proc.ProcessName
                                PID = $proc.Id
                                Pattern = $pattern
                                CommandLine = $cmdLine.Substring(0, [Math]::Min(500, $cmdLine.Length))
                            } -Severity "Critical"

                            try {
