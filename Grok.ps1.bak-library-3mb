                $safe = [bool]::Parse($matches[2])
                $timestamp = $matches[3]
                try {
                    $entryDate = [datetime]::Parse($timestamp)
                    if ($entryDate -lt (Get-Date).AddDays(-$Config.DatabaseCleanupDays)) { continue }
                } catch {}
                $Script:KnownFilesCache[$hash] = $safe
