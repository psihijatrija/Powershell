# --- Handle-UnsignedFile.ps1 ---
function Handle-UnsignedFile($filePath, $reason) {
    # Check whitelist first
    if (Is-WhitelistedFile -filePath $filePath) {
        Log "Whitelisted file skipped: $filePath"
        return $false
    }
    
    $ext = [IO.Path]::GetExtension($filePath).ToLower()
    
    # KILL ON SIGHT for DLL/WINMD in risky paths
    if (($ext -in @('.dll', '.winmd')) -and (Is-InRiskyPath $filePath)) {
        Log "KILL ON SIGHT: $filePath - $reason"
        
        # Force kill any process using this file
        $processes = Get-Process | Where-Object {
            try {
                $_.Modules | Where-Object { $_.FileName -eq $filePath }
            } catch { $false }
        }
        
        foreach ($proc in $processes) {
            # Skip protected and whitelisted processes
            if ($ProtectedProcessNames -contains $proc.Name) { continue }
            if (Is-WhitelistedProcess -processName $proc.Name -processId $proc.Id) { continue }
            
            try {
                Log "Killing process $($proc.Name) (PID: $($proc.Id)) using malicious file"
                Stop-Process -Id $proc.Id -Force -ErrorAction Stop
            } catch {
                Log "Failed to kill process $($proc.Name): $_"
            }
        }
        
        # Quarantine the file
        Do-Quarantine $filePath "$reason - Killed on sight"
        return $true
    }
    
    return $false
}

