                                    Stop-ProcessUsingDLL -filePath $file.FullName
                                    Do-Quarantine $file.FullName "Unsigned DLL/WINMD (aggressive scan)"
                                }
                            } else {
                                # Signed - check if suspicious
                                if (Is-SuspiciousSigned $file.FullName $fileHash) {
                                    Log "Found suspicious signed: $($file.FullName)"
                                    $scannedFiles[$fileHash.Hash] = $false
                                    "$($fileHash.Hash),false" | Out-File -FilePath $Database -Append -Encoding UTF8
                                    
                                    if (Set-FileOwnershipAndPermissions -filePath $file.FullName) {
