        }
 
        $job.LastStartUtc = $NowUtc
 
        try {
            & $job.ScriptBlock
            $job.LastSuccessUtc = [DateTime]::UtcNow
            $job.RestartAttempts = 0
            $job.LastError = $null
            $job.NextRunUtc = $job.LastSuccessUtc.AddSeconds([Math]::Max(1, $job.IntervalSeconds))
        } catch {
            $job.LastError = $_
            $job.RestartAttempts++
 
