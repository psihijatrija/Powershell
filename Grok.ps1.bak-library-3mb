# --- Apply-FirewallRules.ps1 ---
function Apply-FirewallRules {
    param (
        [string]$RegFilePath
    )

    # Import the registry file to apply the firewall rules
    reg import $RegFilePath

    # Block incoming connections for known browsers
    $browsers = @(
        @{Name="Microsoft Edge"; Path="%ProgramFiles(x86)%\Microsoft\Edge\Application\msedge.exe"},
        @{Name="Google Chrome"; Path="%ProgramFiles%\Google\Chrome\Application\chrome.exe"},
        @{Name="Mozilla Firefox"; Path="%ProgramFiles%\Mozilla Firefox\firefox.exe"},
        @{Name="Opera"; Path="%ProgramFiles%\Opera\opera.exe"},
        @{Name="Safari"; Path="%ProgramFiles%\Safari\Safari.exe"}
    )

    foreach ($browser in $browsers) {
        $ruleName = "Block $($browser.Name) Inbound"
        $appPath = [Environment]::ExpandEnvironmentVariables($browser.Path)

        # Check if the application exists
        if (Test-Path $appPath) {
            # Remove existing rule if it exists to avoid duplicates
            netsh advfirewall firewall delete rule name="$ruleName" | Out-Null

            # Add new inbound block rule for the browser
            netsh advfirewall firewall add rule name="$ruleName" dir=in action=block program="$appPath" enable=yes profile=any description="Block inbound connections for $($browser.Name)"
        }
    }

    Write-Host "Firewall rules applied, including browser inbound blocks."
}
