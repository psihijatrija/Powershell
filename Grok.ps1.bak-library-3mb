# --- Scan-ProcessesForBadDLLs.ps1 ---
function Scan-ProcessesForBadDLLs {
    Write-Log "Starting memory-loaded DLL scan..."
    $safeRoots = @("C:\Windows\", "C:\Program Files\", "C:\Program Files (x86)\")
    try {
        foreach ($proc in Get-Process) {
            try {
                foreach ($mod in $proc.Modules) {
                    $dllPath = $mod.FileName
                    if ($safeRoots | Where-Object { $dllPath -and $dllPath.StartsWith($_, [System.StringComparison]::OrdinalIgnoreCase) }) {
                        continue
                    }
                    $fileHash = Calculate-FileHash -filePath $dllPath
                    if (-not $fileHash) { continue }
                    if ($scannedFiles[$fileHash.Hash] -eq $true) {
                        Write-Log "Skipping already scanned valid file: $dllPath (Hash: $($fileHash.Hash))"
                        continue
                    }
                    if ($scannedFiles.ContainsKey($fileHash.Hash) -and -not $scannedFiles[$fileHash.Hash]) {
                        if (Set-FileOwnershipAndPermissions -filePath $dllPath) {
                            Stop-Process -Id $proc.Id -Force -ErrorAction SilentlyContinue
                            Quarantine-File -filePath $dllPath
                            Write-Log "Quarantined unsigned memory DLL: $dllPath from $($proc.Name) (PID $($proc.Id))"
                        }
                        continue
                    }
                    $isValid = $fileHash.Status -eq 'Valid'
                    $scannedFiles[$fileHash.Hash] = $isValid
                    "$($fileHash.Hash),$isValid" | Out-File -FilePath $localDatabase -Append -Encoding UTF8 -ErrorAction Stop
                    Write-Log "Scanned new file: $dllPath (Valid: $isValid)"
                    if (-not $isValid) {
                        if (Set-FileOwnershipAndPermissions -filePath $dllPath) {
                            Stop-Process -Id $proc.Id -Force -ErrorAction SilentlyContinue
                            Quarantine-File -filePath $dllPath
                            Write-Log "Quarantined unsigned memory DLL: $dllPath from $($proc.Name) (PID $($proc.Id))"
                        }
                    }
                }
            } catch {
                Write-Log "Error in $($proc.Name): $($_.Exception.Message)" -EntryType "Warning"
            }
        }
        Write-Log "Memory DLL scan completed."
    } catch {
        Write-Log "Critical error in Scan-ProcessesForBadDLLs: $($_.Exception.Message)" -EntryType "Error"
    }
}

# --- Scan-ProcessesForBadDLLs_Alt2.ps1 ---
function Scan-ProcessesForBadDLLs_Alt2 {
    Write-Log "Starting memory-loaded DLL scan..."
    $safeRoots = @("C:\Windows\", "C:\Program Files\", "C:\Program Files (x86)\")

    if (Test-Path $localDatabase) {
        Get-Content $localDatabase | ForEach-Object {
            if ($_ -match "^[a-fA-F0-9]{64},(True|False)$") {
                $parts = $_.Split(",")
                $scannedFiles[$parts[0].ToLower()] = [bool]::Parse($parts[1])
            }
        }
    }

    foreach ($proc in Get-Process) {
        try {
            foreach ($mod in $proc.Modules) {
                $dllPath = $mod.FileName
                if ($safeRoots | Where-Object { $dllPath.StartsWith($_, [System.StringComparison]::OrdinalIgnoreCase) }) {
                    continue
                }

                $fileHash = Calculate-FileHash -filePath $dllPath
                if (-not $fileHash) { continue }

                if ($scannedFiles[$fileHash.Hash] -eq $true) { continue }

                if ($scannedFiles.ContainsKey($fileHash.Hash) -and -not $scannedFiles[$fileHash.Hash]) {
                    if (Set-FileOwnershipAndPermissions -filePath $dllPath) {
                        Stop-Process -Id $proc.Id -Force -ErrorAction SilentlyContinue
                        Quarantine-File -filePath $dllPath
                    }
                    continue
                }

                $isValid = $fileHash.Status -eq 'Valid'
                $scannedFiles[$fileHash.Hash] = $isValid
                "$($fileHash.Hash),$isValid" | Out-File -FilePath $localDatabase -Append -Encoding UTF8

                if (-not $isValid) {
                    if (Set-FileOwnershipAndPermissions -filePath $dllPath) {
                        Stop-Process -Id $proc.Id -Force -ErrorAction SilentlyContinue
                        Quarantine-File -filePath $dllPath
                        Write-Log "Quarantined unsigned memory DLL: $dllPath from $($proc.Name) (PID $($proc.Id))"
                    }
                }
            }
        } catch {
            Write-Log "Error in $($proc.Name): $($_.Exception.Message)" -EntryType "Warning"
        }
    }

    Write-Log "Memory DLL scan completed."
}

