            [InterfaceType(ComInterfaceType.InterfaceIsIUnknown)]
            interface IMMDevice {
                [PreserveSig]
                int Activate([In] ref Guid id, [In] uint dwClsCtx, [In] IntPtr pActivationParams, out IntPtr ppInterface);
                // Other methods omitted
            }
            
            [ComImport]
            [Guid("5CDF2C82-841E-4546-9722-0CF74078229A")]
