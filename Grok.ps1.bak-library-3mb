function Set-MicrophoneMute {
    param ([bool]$mute)
    $code = @"
        using System;
        using System.Runtime.InteropServices;
        public class AudioControl {
            [ComImport]
            [Guid("A95664D2-9614-4F35-A746-DE8DB63617E6")]
            [InterfaceType(ComInterfaceType.InterfaceIsIUnknown)]
