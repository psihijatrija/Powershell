            interface IAudioEndpointVolume {
                [PreserveSig] int RegisterControlChangeNotify(IntPtr pNotify);
                [PreserveSig] int UnregisterControlChangeNotify(IntPtr pNotify);
                [PreserveSig] int GetChannelCount(out int pnChannelCount);
                [PreserveSig] int SetMasterVolumeLevel(float fLevelDB, ref Guid pguidEventContext);
                [PreserveSig] int SetMasterVolumeLevelScalar(float fLevel, ref Guid pguidEventContext);
                [PreserveSig] int GetMasterVolumeLevel(out float pfLevelDB);
                [PreserveSig] int GetMasterVolumeLevelScalar(out float pfLevel);
                [PreserveSig] int SetChannelVolumeLevel(uint nChannel, float fLevelDB, ref Guid pguidEventContext);
                [PreserveSig] int SetChannelVolumeLevelScalar(uint nChannel, float fLevel, ref Guid pguidEventContext);
                [PreserveSig] int GetChannelVolumeLevel(uint nChannel, out float pfLevelDB);
                [PreserveSig] int GetChannelVolumeLevelScalar(uint nChannel, out float pfLevel);
                [PreserveSig] int SetMute([In] int bMute, [In] ref Guid pguidEventContext);
                [PreserveSig] int GetMute(out int pbMute);
            }
            
            public static void MuteMicrophone(bool mute) {
                Guid CLSID_MMDeviceEnumerator = new Guid("BCDE0395-E52F-467C-8E3D-C4579291692E");
                Guid IID_IAudioEndpointVolume = new Guid("5CDF2C82-841E-4546-9722-0CF74078229A");
                Guid guidNull = Guid.Empty;
                
                Type type = Type.GetTypeFromCLSID(CLSID_MMDeviceEnumerator);
                object enumerator = Activator.CreateInstance(type);
                IMMDeviceEnumerator deviceEnum = (IMMDeviceEnumerator)enumerator;
                
                IMMDevice device;
                deviceEnum.GetDefaultAudioEndpoint(1, 1, out device); // 1 = capture, 1 = multimedia
                
                IntPtr endpointVolumePtr;
                device.Activate(ref IID_IAudioEndpointVolume, 1, IntPtr.Zero, out endpointVolumePtr);
                IAudioEndpointVolume volume = (IAudioEndpointVolume)Marshal.GetObjectForIUnknown(endpointVolumePtr);
                
                volume.SetMute(mute ? 1 : 0, ref guidNull);
                
                Marshal.ReleaseComObject(volume);
                Marshal.ReleaseComObject(device);
                Marshal.ReleaseComObject(enumerator);
            }
        }
"@
    try {
        Add-Type -TypeDefinition $code -Language CSharp
        [AudioControl]::MuteMicrophone($mute)
    }
    catch {
        Write-Host "Error setting microphone mute state: $_"
    }
}

