# --- Get-MitigationConfig.ps1 ---
function Get-MitigationConfig {
  $cfg = $null
  if (Test-Path $ConfigPath) {
    try {
      $cfg = Get-Content $ConfigPath -Raw -Encoding UTF8 | ConvertFrom-Json
      $script:ConfigDir = Split-Path -Parent $ConfigPath
    } catch {
      Write-Log "Error loading config file: $_" "ERROR"
    }
  }
  if (-not $cfg) {
    try {
      $cfg = $EmbeddedConfigJson | ConvertFrom-Json
      Write-Log "Using embedded config (no file at $ConfigPath)"
      $script:ConfigDir = $ScriptDir
    } catch {
      Write-Log "Error loading embedded config: $_" "ERROR"
      return @{ actions = @{}; defaultActionsForVendorProduct = @() }
    }
  }
  $out = @{}
  if ($cfg.actions) {
    $cfg.actions.PSObject.Properties | ForEach-Object {
      $out[$_.Name] = $_.Value
    }
  }
  if ($cfg.templates) {
    $script:Templates = @{}
    $cfg.templates.PSObject.Properties | ForEach-Object {
      $script:Templates[$_.Name] = $_.Value
    }
  }
  $defaults = @()
  if ($cfg.defaultActionsForVendorProduct) {
    $defaults = @($cfg.defaultActionsForVendorProduct)
  }
  return @{ actions = $out; defaultActionsForVendorProduct = $defaults }
}

# --- Get-NAudio.ps1 ---
function Get-NAudio {
    if ((Test-Path $naudioDllPath) -and (Test-Path $naudioCoreDllPath) -and (Test-Path $naudioWasapiDllPath)) {
        Write-Host "NAudio found in cache." -ForegroundColor Green
        return $true
    }
    
    Write-Host "Downloading NAudio (one-time setup)..." -ForegroundColor Yellow
    
    try {
        if (-not (Test-Path $naudioCachePath)) {
            New-Item -ItemType Directory -Path $naudioCachePath -Force | Out-Null
        }
        
        $zipPath = "$naudioCachePath\naudio.zip"
        
        # Download NAudio NuGet package
        [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
        Invoke-WebRequest -Uri $naudioUrl -OutFile $zipPath -UseBasicParsing
        
        # Extract DLLs
        Add-Type -AssemblyName System.IO.Compression.FileSystem
        $zip = [System.IO.Compression.ZipFile]::OpenRead($zipPath)
        
        foreach ($entry in $zip.Entries) {
            # Look for net472 or netstandard2.0 DLLs
            if ($entry.FullName -match "lib/net472/NAudio\.dll$" -or 
                $entry.FullName -match "lib/netstandard2\.0/NAudio\.dll$") {
                $stream = $entry.Open()
                $fileStream = [System.IO.File]::Create($naudioDllPath)
                $stream.CopyTo($fileStream)
                $fileStream.Close()
                $stream.Close()
            }
            if ($entry.FullName -match "lib/net472/NAudio\.Core\.dll$" -or
                $entry.FullName -match "lib/netstandard2\.0/NAudio\.Core\.dll$") {
                $stream = $entry.Open()
                $fileStream = [System.IO.File]::Create($naudioCoreDllPath)
                $stream.CopyTo($fileStream)
                $fileStream.Close()
                $stream.Close()
            }
            if ($entry.FullName -match "lib/net472/NAudio\.Wasapi\.dll$" -or
                $entry.FullName -match "lib/netstandard2\.0/NAudio\.Wasapi\.dll$") {
                $stream = $entry.Open()
                $fileStream = [System.IO.File]::Create($naudioWasapiDllPath)
                $stream.CopyTo($fileStream)
                $fileStream.Close()
                $stream.Close()
            }
        }
        
        $zip.Dispose()
        Remove-Item $zipPath -Force
        
        # If we got the main DLL, we're good (older versions bundle everything)
        if (Test-Path $naudioDllPath) {
            Write-Host "NAudio downloaded and cached." -ForegroundColor Green
            return $true
        }
        
        Write-Host "Could not find NAudio DLLs in package." -ForegroundColor Red
        return $false
    }
    catch {
        Write-Host "Failed to download NAudio: $_" -ForegroundColor Red
        return $false
    }
}

# --- Get-ProcessDetailsAndTerminate.ps1 ---
function Get-ProcessDetailsAndTerminate {
    param (
        [int]$ProcessId
    )

    try {
        # Get process details using the ProcessId
        $process = Get-Process -Id $ProcessId -ErrorAction Stop
        $processName = $process.Name
        $processOwner = (Get-CimInstance Win32_Process -Filter "ProcessId = $ProcessId").GetOwner().User

        # Log process details before termination
        Write-Log "Detected process to terminate: $processName (PID: $ProcessId), Owner: $processOwner"

        # Optionally, perform additional checks on the process (e.g., if it's not a system process)
        if ($processName -notin @("System", "svchost")) {
            Write-Log "Terminating process: $processName (PID: $ProcessId)"
            Stop-Process -Id $ProcessId -Force

            # Quarantine the process executable
            $processPath = $process.Path
            if ($processPath -and (Test-Path $processPath)) {
                $timestamp = (Get-Date).ToString("yyyyMMddHHmmss")
                $dest = [System.IO.Path]::Combine($quarantinePath, "$timestamp`_$([System.IO.Path]::GetFileName($processPath))")
                try {
                    Move-Item -Path $processPath -Destination $dest -Force
                    Write-Log "Quarantined: $processPath to $dest"
                } catch {
                    Write-Log "Error quarantining ${processPath}: $_"
                }
            } else {
                Write-Log "No valid path found for quarantining process: $processName (PID: $ProcessId)"
            }
        } else {
            Write-Log "System process detected, skipping termination: $processName (PID: $ProcessId)"
        }
    } catch {
        Write-Log "Error retrieving details for process ID ${ProcessId}: $(${_}.Exception.Message)"
    }
}

# --- Get-ProcessesHoldingFile.ps1 ---
function Get-ProcessesHoldingFile($file) {
    $holders = @()
    $fileLower = $file.ToLower()
    foreach ($p in Get-Process -ErrorAction SilentlyContinue) {
        try {
            foreach ($m in $p.Modules) {
                if ($null -ne $m.FileName -and $m.FileName.ToLower() -eq $fileLower) {
                    $holders += $p
                    break
                }
            }
        } catch { }
    }
    return $holders | Select-Object -Unique
}

# --- Get-ProcessesUsingFile.ps1 ---
function Get-ProcessesUsingFile {
    param ([string]$FilePath)
    $processes = @()
    try {
        Get-Process | Where-Object { $_.Path } | ForEach-Object {
            try {
                $modules = $_.Modules
                if ($modules | Where-Object { $_.FileName -eq $FilePath }) {
                    Write-Log "Found process $($_.ProcessName) (PID: $($_.Id)) using $FilePath"
                    $processes += $_
                }
            } catch {
                Write-Log "Error checking modules for PID $($_.Id): $_"
            }
        }
    } catch {
        Write-Log "Error querying processes for ${FilePath}: $_"
    }
    return $processes
}

