# --- Scan-AllDrivesAggressively.ps1 ---
function Scan-AllDrivesAggressively {
    Log "Starting aggressive all-drive unsigned DLL/WINMD scan"
    $drives = Get-CimInstance -ClassName Win32_LogicalDisk | Where-Object { $_.DriveType -in (2, 3, 4) }
    
    foreach ($drive in $drives) {
        $root = $drive.DeviceID + "\"
        Log "Scanning drive: $root"
        
        try {
            $files = Get-ChildItem -Path $root -Include @("*.dll","*.winmd") -Recurse -File -ErrorAction SilentlyContinue
            
            foreach ($file in $files) {
                # Skip quarantine folder
                if ($file.FullName -like "$Quarantine*") { continue }
                
                if (Should-ExcludeFile $file.FullName) { continue }
                
                try {
                    $fileHash = Calculate-FileHash -filePath $file.FullName
                    if ($fileHash) {
                        # Check if already scanned
                        if ($scannedFiles.ContainsKey($fileHash.Hash)) {
                            if (-not $scannedFiles[$fileHash.Hash]) {
                                # Previously identified as bad - quarantine again
                                if (Set-FileOwnershipAndPermissions -filePath $file.FullName) {
                                    Stop-ProcessUsingDLL -filePath $file.FullName
                                    Do-Quarantine $file.FullName "Previously identified threat (drive scan)"
                                }
                            }
                        } else {
                            $isValid = $fileHash.Status -eq "Valid"
                            
