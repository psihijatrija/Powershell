function Write-GLog {
    param([string]$Message, [string]$Level = 'INFO')
    try { "$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') [$Level] $Message" | Add-Content $script:LogFile -Force -EA 0 } catch {}
    switch ($Level) {
        'ALERT' { Write-Host $Message -ForegroundColor Red }
        'WARN'  { Write-Host $Message -ForegroundColor Yellow }
        'CYAN'  { Write-Host $Message -ForegroundColor Cyan }
        default { Write-Host $Message }
    }
}
function Write-Log {
    param([string]$Message,[string]$Level='INFO',[string]$LogFile,[string]$EntryType,[string]$ProcessName,[string]$Reason,[string]$Category,[string]$Risk,[string]$DetectionType)
    if ($EntryType -and $Level -eq 'INFO') { $Level = $EntryType }
    if ($ProcessName) { $Message = "[$ProcessName] $Message" }
    if ($Reason) { $Message = "$Message | $Reason" }
    $path = if ($LogFile) { $LogFile } else { $script:LogFile }
    try { "$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss') [$Level] $Message" | Add-Content $path -Force -EA 0 } catch {}
    $lv = if ($Level -match 'Error|ALERT|Critical') { 'ALERT' } elseif ($Level -match 'Warn') { 'WARN' } else { 'INFO' }
    Write-GLog $Message $lv
}
function Log-Info([string]$Message) { Write-Log $Message 'INFO' }
function Log-Error([string]$Message) { Write-Log $Message 'ALERT' }
function Write-Detection {
    param([string]$Message,[string]$Level='ALERT',[string]$ProcessName,[string]$Reason,[string]$EntryType,[string]$DetectionType,[string]$Risk,[string]$Category)
    if ($ProcessName) { $Message = "[$ProcessName] $Message" }
    if ($Reason) { $Message = "$Message | $Reason" }
    Write-Log $Message 'ALERT'
}
function Write-RootkitLog([string]$Message,[string]$Level='ALERT') { Write-Log "[ROOTKIT] $Message" $Level }
function Write-GSecurityLog {
    param([Parameter(Position=0)][string]$Message,[Parameter(Position=1)][string]$Level='INFO')
    Write-Log "[GSEC] $Message" $Level
}

