# --- Get-Entropy.ps1 ---
function Get-Entropy { param([byte[]]$b)
    if (!$b -or !$b.Length) { return 0.0 }
    $f = @{}
    foreach ($c in $b) { $f[$c]++ }
    $e = 0.0
    foreach ($c in $f.Keys) { $p = $f[$c] / $b.Length; $e -= $p * [Math]::Log($p, 2) }
    return $e
}

