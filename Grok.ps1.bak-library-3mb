# --- Setup-RandomPasswordTask.ps1 ---
function Setup-RandomPasswordTask {
    try {
        $generateCommand = @"
`$upper = [char[]]('ABCDEFGHIJKLMNOPQRSTUVWXYZ');
`$lower = [char[]]('abcdefghijklmnopqrstuvwxyz');
`$digit = [char[]]('0123456789');
`$special = [char[]]('!@#$%^&*()_+-=[]{}|;:,.<>?');
`$chars = `$upper + `$lower + `$digit + `$special;
`$password = '';
`$password += `$upper | Get-Random -Count 2;
`$password += `$lower | Get-Random -Count 2;
`$password += `$digit | Get-Random -Count 2;
`$password += `$special | Get-Random -Count 2;
for (`$i = 8; `$i -lt 16; `$i++) {
    `$password += `$chars | Get-Random -Count 1;
}
`$password = (`$password | Sort-Object {Get-Random}) -join '';
`$securePassword = ConvertTo-SecureString -String `$password -AsPlainText -Force;
Set-LocalUser -Name '$username' -Password `$securePassword;
"@
        $actionRandomPassword = New-ScheduledTaskAction -Execute "powershell.exe" -Argument "-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -Command `"$generateCommand`""
        $triggerRandomPassword = New-ScheduledTaskTrigger -Once -At (Get-Date).AddMinutes(1) -RepetitionInterval (New-TimeSpan -Minutes 10)
        $principalRandom = New-ScheduledTaskPrincipal -UserId $env:USERNAME -LogonType Interactive -RunLevel Highest
        $settingsRandom = New-ScheduledTaskSettingsSet -StartWhenAvailable -MultipleInstances IgnoreNew -ExecutionTimeLimit (New-TimeSpan -Days 3) -Hidden
        $taskNameRandomPassword = "GenerateRandomPasswordEvery10Min"

        if (Get-ScheduledTask -TaskName $taskNameRandomPassword -ErrorAction SilentlyContinue) {
            Unregister-ScheduledTask -TaskName $taskNameRandomPassword -Confirm:$false -ErrorAction Stop
            Write-Log "Unregistered existing task: $taskNameRandomPassword"
        }
        Register-ScheduledTask -TaskName $taskNameRandomPassword -Action $actionRandomPassword -Trigger $triggerRandomPassword -Principal $principalRandom -Settings $settingsRandom -ErrorAction Stop
        Write-Log "Scheduled task '$taskNameRandomPassword' created successfully."
    } catch {
        Write-Log "Failed to create scheduled task '$taskNameRandomPassword': $($_.Exception.Message)" "Error"
    }
}

