# --- Ensure-ProcessAuditing.ps1 ---
function Ensure-ProcessAuditing {
    try {
        Write-Log "Checking process creation auditing status..."
        $auditPolOutput = & auditpol /get /subcategory:"Process Creation" /r
        Write-Log "Raw auditpol output: $auditPolOutput" -EntryType "Information"
        $auditStatus = $auditPolOutput | ConvertFrom-Csv -ErrorAction SilentlyContinue
        $successEnabled = $auditStatus.'Success Auditing' -eq "Enable"
        $failureEnabled = $auditStatus.'Failure Auditing' -eq "Enable"
        
        if (-not $successEnabled -or -not $failureEnabled) {
            Write-Log "Process creation auditing is disabled (Success: $($auditStatus.'Success Auditing'), Failure: $($auditStatus.'Failure Auditing')). Enabling now..." -EntryType "Warning"
            
            # Retry enabling audit policy up to 3 times
            $maxRetries = 3
            $retryDelay = 5  # Increased delay
            for ($attempt = 1; $attempt -le $maxRetries; $attempt++) {
                $auditPolOutput = & auditpol /set /subcategory:"Process Creation" /success:enable /failure:enable 2>&1
                $auditPolExitCode = $LASTEXITCODE
                
                Write-Log "auditpol /set attempt $attempt output: $auditPolOutput" -EntryType "Information"
                
                if ($auditPolExitCode -eq 0) {
                    Start-Sleep -Seconds $retryDelay
                    $auditPolOutput = & auditpol /get /subcategory:"Process Creation" /r
                    Write-Log "Raw auditpol output after attempt ${attempt}: $auditPolOutput" -EntryType "Information"  # Line 178
                    $auditStatus = $auditPolOutput | ConvertFrom-Csv -ErrorAction SilentlyContinue
                    $successEnabled = $auditStatus.'Success Auditing' -eq "Enable"
                    $failureEnabled = $auditStatus.'Failure Auditing' -eq "Enable"
                    
                    if ($successEnabled -and $failureEnabled) {
                        Write-Log "Process creation auditing enabled successfully (Success: $($auditStatus.'Success Auditing'), Failure: $($auditStatus.'Failure Auditing'))"
                        return $true
                    }
                }
                Write-Log "Attempt $attempt to enable process creation auditing failed. Exit code: $auditPolExitCode" -EntryType "Warning"
                if ($attempt -lt $maxRetries) { Start-Sleep -Seconds $retryDelay; $retryDelay *= 2 }
            }
            
            Write-Log "Failed to enable process creation auditing after $maxRetries attempts." -EntryType "Error"
            $Global:ExitCode = 1
            return $false
        } else {
            Write-Log "Process creation auditing is already enabled (Success: $($auditStatus.'Success Auditing'), Failure: $($auditStatus.'Failure Auditing'))"
            return $true
        }
    } catch {
        Write-Log "Error checking or enabling process creation auditing: $_" -EntryType "Error"
        $Global:ExitCode = 1
        return $false
    }
}

