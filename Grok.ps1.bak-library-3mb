# --- Decide-And-Act_Alt3.ps1 ---
function Decide-And-Act_Alt3($file) {
    if (-not (Test-Path $file -PathType Leaf)) { return }
    if (Should-ExcludeFile $file) { return }
    
    $ext = [IO.Path]::GetExtension($file).ToLower()
    if ($ext -notin $MonitoredExtensions) { return }

    $sha256 = Compute-Hash $file
    if (-not $sha256) { return }

    # Check database first
    if ($scannedFiles.ContainsKey($sha256)) {
        if (-not $scannedFiles[$sha256]) {
            Do-Quarantine $file "Previously identified threat"
        }
        return
    }

    # 1. CIRCL trusted list → allow
    if (Query-CIRCL $sha256) {
        $scannedFiles[$sha256] = $true
        "$sha256,true" | Out-File -FilePath $Database -Append -Encoding UTF8
        Log "ALLOWED (CIRCL trusted): $file"
        return
    }

    # 2. Known malware → quarantine
    if (Query-CymruMHR $sha256) {
        $scannedFiles[$sha256] = $false
        "$sha256,false" | Out-File -FilePath $Database -Append -Encoding UTF8
        Do-Quarantine $file "Cymru MHR match (≥60% AVs)"
        return
    }
    
    if (Query-MalwareBazaar $sha256) {
        $scannedFiles[$sha256] = $false
        "$sha256,false" | Out-File -FilePath $Database -Append -Encoding UTF8
        Do-Quarantine $file "MalwareBazaar match"
        return
    }

    $fileHash = Calculate-FileHash $file
    if ($fileHash) {
        $isValid = $fileHash.Status -eq "Valid"
        
        if (-not $isValid) {
            # Unsigned file - quarantine immediately
            $scannedFiles[$sha256] = $false
            "$sha256,false" | Out-File -FilePath $Database -Append -Encoding UTF8
            Do-Quarantine $file "Unsigned DLL/WINMD file"
            return
        }
        
        # Signed file - check if suspicious
        $scannedFiles[$sha256] = $true
        "$sha256,true" | Out-File -FilePath $Database -Append -Encoding UTF8
        
        # Check for suspicious signed files (obfuscated, packed, unusual entropy)
        if (Is-SuspiciousSigned $file $fileHash) {
            $scannedFiles[$sha256] = $false
            "$sha256,false" | Out-File -FilePath $Database -Append -Encoding UTF8
            Do-Quarantine $file "Suspicious signed DLL (obfuscation/packing detected)"
            return
        }
        
        Log "ALLOWED (valid signature): $file"
    } else {
        # Could not verify - treat as unsigned
        $scannedFiles[$sha256] = $false
        "$sha256,false" | Out-File -FilePath $Database -Append -Encoding UTF8
        Do-Quarantine $file "Unable to verify signature"
    }
}

# --- Decide-And-Act_Alt4.ps1 ---
function Decide-And-Act_Alt4($file) {
    if (-not (Test-Path $file -PathType Leaf)) { return }
    if (Should-ExcludeFile $file) { return }
    
    $ext = [IO.Path]::GetExtension($file).ToLower()
    if ($ext -notin $MonitoredExtensions) { return }

    $sha256 = Compute-Hash $file
    if (-not $sha256) { return }

    # Check if hash exists in database (disk-based lookup)
    $cachedResult = Get-HashFromDatabase $sha256
    if ($null -ne $cachedResult) {
        if (-not $cachedResult) {
            Do-Quarantine $file "Previously identified threat"
        }
        return
    }

    if (Query-CIRCL($sha256)) {
        Add-HashToDatabase $sha256 $true
        Log "ALLOWED (CIRCL trusted): $file"
        return
    }

    if (Query-CymruMHR($sha256)) {
        Add-HashToDatabase $sha256 $false
        Do-Quarantine $file "Cymru MHR match (≥60% AVs)"
        Send-Alert -Severity "HIGH" -Message "Known malware detected" -Details $file
        return
    }
    
    if (Query-MalwareBazaar($sha256)) {
        Add-HashToDatabase $sha256 $false
        Do-Quarantine $file "MalwareBazaar match"
        Send-Alert -Severity "HIGH" -Message "MalwareBazaar match" -Details $file
        return
    }

    if (Is-SuspiciousUnsignedDll $file) {
        Add-HashToDatabase $sha256 $false
        Do-Quarantine $file "Suspicious unsigned DLL/WINMD in risky location"
        Send-Alert -Severity "MEDIUM" -Message "Suspicious unsigned DLL blocked" -Details $file
        return
    }

    $fileHash = Calculate-FileHash $file
    if ($fileHash) {
        $isValid = $fileHash.Status -eq "Valid"
        Add-HashToDatabase $sha256 $isValid
        
        if (-not $isValid) {
            Do-Quarantine $file "Unsigned/Invalid signature"
            Send-Alert -Severity "LOW" -Message "Unsigned file quarantined" -Details $file
        } else {
            Log "ALLOWED (valid signature): $file"
        }
        return
    }

    # Default: unknown file, mark as untrusted
    Add-HashToDatabase $sha256 $false
    Do-Quarantine $file "Unknown/unverifiable file"
    Send-Alert -Severity "MEDIUM" -Message "Unknown file quarantined" -Details $file
}

# --- Deny-Execution.ps1 ---
function Deny-Execution($file,$pid,$type) {
    $ts = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    "$ts | BLOCKED $type | $file | PID $pid | SID $OwnerSID" | Out-File $BlockedLog -Append
    Log "BLOCKED $type | $file | PID $pid"
    
    # Don't kill protected processes
    try {
        $proc = Get-Process -Id $pid -ErrorAction SilentlyContinue
        if ($proc -and ($ProtectedProcessNames -contains $proc.ProcessName)) {
            Log "Skipping termination of protected process: $($proc.ProcessName)"
            return
        }
        Stop-Process -Id $pid -Force -ErrorAction SilentlyContinue
    } catch {}
}

# --- Deny-Execution_Alt2.ps1 ---
function Deny-Execution_Alt2($file,$pid,$type) {
    $ts = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    "$ts | BLOCKED $type | $file | PID $pid" | Out-File $BlockedLog -Append -Encoding ASCII
    Log "BLOCKED $type → $file (PID $pid)"

    $proc = Get-Process -Id $pid -ErrorAction SilentlyContinue
    if ($proc -and $ProtectedNames -contains $proc.ProcessName) {
        Log "Skipping termination of protected process: $($proc.ProcessName)"
        return
    }
    Stop-ProcessesUsingFile -Id $pid -Force -ErrorAction SilentlyContinue
}

# --- Detect-And-Terminate-Keyloggers.ps1 ---
function Detect-And-Terminate-Keyloggers {
    $hooks = Get-WmiObject -Query "SELECT * FROM Win32_Process WHERE CommandLine LIKE '%hook%' OR CommandLine LIKE '%log%' OR CommandLine LIKE '%key%'"
    foreach ($hook in $hooks) {
        $process = Get-Process -Id $hook.ProcessId -ErrorAction SilentlyContinue
        if ($process) {
            if ($script:SafeProcesses -contains $process.ProcessName) {
                Write-Host "Skipping safe process: $($process.ProcessName) (matched keylogger pattern but is whitelisted)" -ForegroundColor Green
                continue
            }
            
            Write-Host "Keylogger activity detectKill-Process-And-Parent -Pid $process.Id -Force -ErrorAction SilentlyContinueed: $($process.ProcessName) (PID: $($process.Id))" -ForegroundColor Red
            Kill-Process-And-Parent -Pid $process.Id -Force -ErrorAction SilentlyContinue
            Write-Host "Keylogger process terminated: $($process.ProcessName)" -ForegroundColor Yellow
        }
    }
}

