        shExpMatch(host, "*.youtu.be") ||
        shExpMatch(host, "youtube.com") ||
        shExpMatch(host, "youtu.be")) {
        return "PROXY 127.0.0.1:$Port";
    }
    return "DIRECT";
}
"@

